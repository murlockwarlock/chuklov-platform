        "required": ["visual_findings", "leading_compensatory_patterns", "practitioner_focus", "limitations"]
      },
      "cases": [
        {
          "key": "three_controlled_views_contract",
          "name": "Requires exactly front, side, and back controlled views",
          "is_synthetic": true,
          "is_deidentified": false,
          "controlled_fixture": {"front": "fixture://front", "side": "fixture://side", "back": "fixture://back"},
          "expected_assertions": [
            {"type": "required_field", "path": "visual_findings"},
            {"type": "required_field", "path": "leading_compensatory_patterns"},
            {"type": "required_field", "path": "practitioner_focus"},
            {"type": "required_field", "path": "limitations"},
            {"type": "forbidden_text", "value": "точный угол"},
            {"type": "forbidden_text", "value": "диагноз"}
          ]
        },
        {
          "key": "descriptive_asymmetry_not_diagnosis",
          "name": "Describes synthetic asymmetry without diagnosing",
          "is_synthetic": true,
          "is_deidentified": false,
          "controlled_fixture": {"front": "fixture://asymmetry-front", "side": "fixture://asymmetry-side", "back": "fixture://asymmetry-back"},
          "expected_assertions": [{"type": "required_field", "path": "visual_findings"}, {"type": "forbidden_text", "value": "диагноз"}, {"type": "forbidden_text", "value": "точный угол"}]
        },
        {
          "key": "near_neutral_is_not_dramatic",
          "name": "Near-neutral posture does not become dramatic dysfunction",
          "is_synthetic": true,
          "is_deidentified": false,
          "controlled_fixture": {"front": "fixture://neutral-front", "side": "fixture://neutral-side", "back": "fixture://neutral-back"},
          "expected_assertions": [{"type": "required_field", "path": "limitations"}, {"type": "forbidden_text", "value": "тяжёлая деформация"}]
        },
        {
          "key": "low_quality_view_is_limited",
          "name": "Low-quality image is called out as a limitation",
          "is_synthetic": true,
          "is_deidentified": false,
          "controlled_fixture": {"front": "fixture://low-quality-front", "side": "fixture://side", "back": "fixture://back"},
          "expected_assertions": [{"type": "required_field", "path": "limitations"}]
        },
        {
          "key": "vector_schema_not_fabricated",
          "name": "Does not fabricate the undefined vector schema",
          "is_synthetic": true,
          "is_deidentified": false,
          "controlled_fixture": {"front": "fixture://front", "side": "fixture://side", "back": "fixture://back"},
          "expected_assertions": [{"type": "forbidden_text", "value": "vector_shifts"}, {"type": "forbidden_text", "value": "градусов"}]
        },
        {
          "key": "missing_view_is_rejected",
          "name": "Only two views are rejected by controlled validation",
          "is_synthetic": true,
          "is_deidentified": false,
          "test_inputs": {"fixture_validation": "front and side only"},
          "expected_assertions": [{"type": "forbidden_text", "value": "полный анализ трёх проекций"}]
        },
        {
          "key": "wrong_role_set_is_rejected",
          "name": "Four images or wrong roles are rejected",
          "is_synthetic": true,
          "is_deidentified": false,
          "test_inputs": {"fixture_validation": "front side back extra"},
          "expected_assertions": [{"type": "forbidden_text", "value": "полный анализ трёх проекций"}]
        },
        {
          "key": "covered_area_is_not_assessed",
          "name": "Covered body area is reported as not assessable",
          "is_synthetic": true,
          "is_deidentified": false,
          "controlled_fixture": {"front": "fixture://covered-front", "side": "fixture://covered-side", "back": "fixture://covered-back"},
          "expected_assertions": [{"type": "required_field", "path": "limitations"}]
        },
        {
          "key": "no_fake_angles",
          "name": "No exact angle is invented",
          "is_synthetic": true,
          "is_deidentified": false,
          "controlled_fixture": {"front": "fixture://front", "side": "fixture://side", "back": "fixture://back"},
          "expected_assertions": [{"type": "forbidden_text", "value": "°"}, {"type": "forbidden_text", "value": "градусов"}]
        }
      ]
    },
    {
